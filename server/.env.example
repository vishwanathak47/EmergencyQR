# Server environment variables example
# In production fill these values with your deployment configuration
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/emergency_db?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-with-a-secure-random-secret
JWT_REFRESH_SECRET=replace-with-a-secure-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# The frontend domain used when generating QR codes. Use your deployed frontend URL (no trailing slash)
DEPLOYED_DOMAIN=https://app.yourdomain.com
# Allowed frontend origin for CORS
CLIENT_URL=https://app.yourdomain.com
NODE_ENV=production
